SUPABASE_DATABASE_URL=
UPSTASH_REDIS_URL=rediss://default:password@host:6379
UPSTASH_REDIS_ADDR=
UPSTASH_REDIS_PASSWORD=
MLDSA_SERVER_PRIVATE_KEY=
MLDSA_SERVER_PUBLIC_KEY=
TICKET_TTL_SECONDS=600
# Supabase Storage (private "evidence-files" bucket) for uploaded evidence.
# SUPABASE_URL defaults to https://<ref>.supabase.co derived from the
# SUPABASE_DATABASE_URL host when left empty; explicit is safer.
SUPABASE_URL=
# Service role key (secret). Omit until you want to enable evidence uploads —
# without it the upload/download endpoints answer 503.
SUPABASE_SERVICE_ROLE_KEY=
# Upload cap. Defaults to 100 (MB). Enforced server-side + on the storage
# bucket's file_size_limit.
MAX_UPLOAD_SIZE_MB=50
# Malware scanning. Default false = prototype mode: uploads are hash-chained
# and audited with scan_status "skipped_prototype_mode" (see README).
MALWARE_SCAN_ENABLED=false
# Comma-separated strict origin allowlist for CORS + WebSocket Origin checks.
# Each value must match the request's Origin header EXACTLY (no wildcards).
# The backend fails closed: any origin not listed here is blocked.
# - http://localhost:3000   Tauri dev server origin (devUrl)
# - http://tauri.localhost  Tauri v2 production webview origin (Windows, plain http)
# - tauri://localhost       Tauri v2 production webview origin (macOS/Linux)
# If unset, the backend defaults to the three values above.
ALLOWED_ORIGINS=http://localhost:3000,http://tauri.localhost,tauri://localhost
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/stream
